{
    "$schema": "https://turborepo.com/schema.json",
    "ui": "tui",
    "tasks": {
        "dev": {
            "cache": false,
            "persistent": true
        },
        "build": {
            "dependsOn": ["^build", "sync:assets"],
            "outputs": [".next/**", "!.next/cache/**"],
            "env": ["NEXT_PUBLIC_SUPABASE_URL", "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/shared/src/**"]
        },
        "lint": {
            "outputs": [],
            "dependsOn": ["^lint"]
        },
        "typecheck": {
            "outputs": [],
            "dependsOn": ["^typecheck"]
        },
        "sync:assets": {
            "cache": false,
            "inputs": ["$TURBO_ROOT$/packages/shared/assets/images/**", "$TURBO_ROOT$/scripts/sync-brand-assets.mjs"]
        }
    }
}
