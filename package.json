{
    "name": "laviann",
    "version": "0.1.0",
    "private": true,
    "packageManager": "bun@1.4.3",
    "engines": {
        "node": ">=22.0.0"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo run dev",
        "dev:customer": "bun run --filter @laviann/customer dev",
        "dev:vendor": "bun run --filter @laviann/vendor dev",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "typecheck": "turbo run typecheck",
        "check": "turbo run lint typecheck",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky",
        "test:commit-msg": "sh scripts/test-commit-msg.sh",
        "sync:assets": "node scripts/sync-brand-assets.mjs",
        "test:assets": "node --test scripts/test-sync-brand-assets.test.mjs",
        "test:theme": "node --test scripts/test-theme.test.mjs"
    },
    "devDependencies": {
        "husky": "^9.1.7",
        "prettier": "^3.6.2",
        "turbo": "^2.11.7",
        "typescript": "^6.0.3"
    }
}
