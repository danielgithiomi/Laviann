# Public project configuration. Leave URL blank for the read-only preview.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Private server only. NEVER prefix either of these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# At least 32 random characters; use the SAME value in both apps.
SERVER_TOKEN_SECRET=

# Exact browser origins. Change these when using different ports or approved hosts.
APP_ORIGIN=http://localhost:3001
CUSTOMER_ORIGIN=http://localhost:3000

# Only true behind a trusted proxy that REPLACES x-forwarded-for.
# False uses one shared ten-minute bucket per action, suitable for local demo traffic.
TRUST_PROXY_IP=false
